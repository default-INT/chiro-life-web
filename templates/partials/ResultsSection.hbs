<section class="results-section section" id="transformation">
  <div class="page-container">
    <div class="section-heading">
      <h2 class="section-title">Visible Transformation</h2>
      <p class="section-description">Consistent use restores the skin's natural vitality. See the difference<br>pure ingredients make.</p>
    </div>
    <div class="results-grid">
      {{#each results}}
        <article class="result-card">
          <div class="result-image">
            <img src="{{image}}" width="375" height="375" loading="lazy" decoding="async" alt="{{alt}}">
          </div>
          <h3>{{title}}</h3>
          <p>{{description}}</p>
        </article>
      {{/each}}
    </div>
    <div class="results-action">
      <a class="app-button app-button-wide" href="{{product.amazonShortUrl}}" target="_blank" rel="noopener noreferrer">Shop Value Size Now</a>
    </div>
  </div>
</section>

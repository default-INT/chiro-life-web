<section class="results-section section" id="transformation">
  <div class="page-container">
    <div class="section-heading">
      <h2 class="section-title">A Closer Look at the Balm</h2>
      <p class="section-description">Get to know the jar, ingredients and whipped texture.</p>
    </div>
    <div class="results-grid">
      {{#each results}}
        <article class="result-card">
          <div class="result-image">
            <img src="{{image}}" width="375" height="375" loading="lazy" decoding="async" alt="{{alt}}">
          </div>
          <h3>{{title}}</h3>
          <p>{{description}}</p>
        </article>
      {{/each}}
    </div>
    <div class="results-action">
      <a class="app-button app-button-wide" data-analytics-event="amazon_buy_click" href="{{product.amazonShortUrl}}" target="_blank" rel="noopener noreferrer">Shop the 4.4 oz Jar on Amazon</a>
    </div>
  </div>
</section>

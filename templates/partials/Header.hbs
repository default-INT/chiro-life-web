<a class="skip-link" href="#main-content">Skip to content</a>
<header class="header">
  <div class="header-content">
    <a class="header-logo" href="/" aria-label="ChiroLife home">ChiroLife</a>
    <button class="header-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="header-menu-toggle-label">Menu</span>
      <span class="header-menu-toggle-icon" aria-hidden="true"></span>
    </button>
    <nav class="header-navigation" id="primary-navigation" aria-label="Primary navigation">
      <a class="header-navigation-link" href="{{product.path}}"{{#if page.isProduct}} aria-current="page"{{/if}}>The Balm</a>
      <a class="header-navigation-link" href="/ingredients/"{{#if page.isIngredients}} aria-current="page"{{/if}}>Ingredients</a>
      <a class="header-navigation-link" href="/how-to-use-tallow-balm/"{{#if page.isHowToUse}} aria-current="page"{{/if}}>How to Use</a>
      <a class="header-navigation-link" href="/guides/"{{#if page.isGuides}} aria-current="{{#if page.isArticle}}true{{else}}page{{/if}}"{{/if}}>Guides</a>
      <a class="header-navigation-link" href="/about/"{{#if page.isAbout}} aria-current="page"{{/if}}>About</a>
      <a class="header-navigation-link header-navigation-link-mobile header-email-link" href="mailto:{{contact.email}}" aria-label="Email ChiroLife">
        <img class="injectable-svg" src="/assets/icons/mail.svg" width="20" height="20" alt="">
        <span class="header-email-label">Email us</span>
      </a>
      <a class="app-button header-menu-buy" data-analytics-event="amazon_buy_click" href="{{product.amazonShortUrl}}" target="_blank" rel="noopener noreferrer">Buy Now</a>
    </nav>
    <div class="header-actions">
      <a class="header-email-link header-email-action" href="mailto:{{contact.email}}" aria-label="Email ChiroLife">
        <img class="injectable-svg" src="/assets/icons/mail.svg" width="20" height="20" alt="">
      </a>
      <a class="app-button app-button-small" data-analytics-event="amazon_buy_click" href="{{product.amazonShortUrl}}" target="_blank" rel="noopener noreferrer">Shop Now</a>
    </div>
  </div>
</header>

<header class="header">
  <div class="header-content">
    <a class="header-logo" href="#balm" aria-label="ChiroLife home">ChiroLife</a>
    <button class="header-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="header-menu-toggle-label">Menu</span>
      <span class="header-menu-toggle-icon" aria-hidden="true"></span>
    </button>
    <nav class="header-navigation" id="primary-navigation" aria-label="Primary navigation">
      {{#each navigation}}
        <a class="header-navigation-link" href="{{to}}">{{title}}</a>
      {{/each}}
    </nav>
    <a class="app-button app-button-small" href="#contact">Shop Now</a>
  </div>
</header>
